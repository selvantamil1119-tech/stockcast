{
  "name": "retail-demand-forecasting-platform",
  "version": "1.0.0",
  "description": "Smart Retail Demand Forecasting & Inventory Replenishment Platform (MERN Stack)",
  "scripts": {
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm run dev",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run start:server\" \"npm run start:client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run start:server\" \"npm run start:client\"",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "install:all": "cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "mern",
    "inventory",
    "demand-forecasting",
    "retail",
    "eoq",
    "rop"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
